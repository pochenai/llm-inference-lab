+unsafe fn expert_project<T: DType>(
+    out: &mut Tensor<T>,
+    x: &Tensor<T>,
+    weight: Weight<T>,
+    selected: &Tensor<i32>,
+    input_repeat: usize,
+    exec: &ExecutionContext,
+) -> Result<()> {
+    let generics = vec![
+        T::DTYPE.to_string(),
+        x.shape()[1].to_string(),
+        out.shape()[1].to_string(),
+        selected.shape()[1].to_string(),
+    ];
+    if T::DTYPE == bf16::DTYPE {
+        kernels::expert_mma(
+            out.partition([1, EXPERT_OUTPUT_COLUMNS]),
+            x,
+            weight,
+            selected,
+            input_repeat as i32,
+        )
+        .generics(generics)
+        .execute(exec)?;
+    } else {
+        kernels::expert(
+            out.partition([1, EXPERT_OUTPUT_COLUMNS]),
+            x,
+            weight,
+            selected,
+            input_repeat as i32,
+        )
+        .generics(generics)
+        .execute(exec)?;
+    }
+    Ok(())
+}
