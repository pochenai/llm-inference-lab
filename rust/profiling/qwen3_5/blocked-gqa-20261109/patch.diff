--- a/rust/engine/src/runner/model/qwen3_5/tests.rs
+++ b/rust/engine/src/runner/model/qwen3_5/tests.rs
@@ -1115,3 +1115,202 @@ async fn bf16_packed_a_b_preserves_mma_accumulators() -> Result<()> {
     }
     Ok(())
